# DeepShield-MF local configuration.
# Copy to `.env` in the project root (same folder as this file) and edit.
# Both backend/app.py and streamlit_app.py read this file; real environment
# variables override it. `.env` is git-ignored - never commit secrets.

# ---- Flask backend (backend/app.py) ----
HOST=127.0.0.1
PORT=5000

# Which model POST /predict serves:
#   finetuned (default)  the final research model: face crops, fine-tuned ResNet50 + ViT,
#                        one video-level score against the threshold chosen on validation
#   vit                  the original ViT-B/16 frame classifier (majority vote over frames)
# SERVE_MODEL=finetuned
# Fine-tuned checkpoint (written by scripts/finetune_e2e.py, README Step 8). Default:
# FINETUNED_CHECKPOINT=results/ffpp_c23/e2e_finetune_aug-frame_final/seed0/checkpoints/best_trainable.pth

# ViT checkpoint (SERVE_MODEL=vit). Default: backend/models/best_vit_model.pth
# MODEL_PATH=backend/models/best_vit_model.pth
# Optional: download the checkpoint on startup if MODEL_PATH does not exist.
# MODEL_URL=
# MODEL_SHA256=

# Model output index -> label (comma separated, index order).
# The shipped checkpoint uses 0 = fake (manipulated), 1 = real.
CLASS_NAMES=fake,real

MAX_CONTENT_LENGTH_MB=100
# CORS_ALLOWED_ORIGINS=http://localhost:8501

# ---- Research pipeline (scripts/, deepshield/) ----
# FaceForensics++ download in the official layout
# (original_sequences/youtube/c23/videos, manipulated_sequences/<Method>/c23/videos).
# Default: <repo>/data/FaceForensics++
# DEEPSHIELD_FFPP_DIR=D:/DeepFakeDatasets/FaceForensics++
# Celeb-DF downloads in the official layout (Celeb-real, Celeb-synthesis, YouTube-real,
# List_of_testing_videos.txt), used only for the cross-dataset test.
# Defaults: <repo>/data/Celeb-DF-V1 and <repo>/data/Celeb-DF-V2
# DEEPSHIELD_CELEBDF_V1_DIR=D:/Celeb-DF-V1
# DEEPSHIELD_CELEBDF_V2_DIR=D:/Celeb-DF-V2
# Derived data (face crops, features). Default: <repo>/data
# DEEPSHIELD_DATA_DIR=

# ---- Streamlit frontend (streamlit_app.py) ----
# Must point at the backend's HOST:PORT above.
DEEPSHIELD_BACKEND_URL=http://127.0.0.1:5000
